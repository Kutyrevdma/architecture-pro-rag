@startuml
actor Scheduler

rectangle "docs/" as Docs
component "update_index.py" as UpdateScript
component "Chunker" as Chunker
component "SentenceTransformer\n(all-MiniLM-L6-v2)" as EmbeddingModel
database "FAISS index\n(task3/faiss.index)" as FAISS
file "state.json" as StateFile
file "update.log" as Logs

Scheduler -> UpdateScript : cron запускает
UpdateScript -> Docs : scan files
UpdateScript -> Chunker : chunk documents
Chunker -> EmbeddingModel : encode chunks
EmbeddingModel -> FAISS : add(vectors)
UpdateScript -> StateFile : write hashes
UpdateScript -> Logs : append status/errors
@enduml
